@startuml
title NexoStock - Diagrama de Implantação
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundcorner 6

node "GitHub" <<repository>> as github #FBE6D4 {
  artifact "Repositório de Código e Documentação\nserver.js · storage.js · public/\nrender.yaml · package.json · package-lock.json" as source #FEF9EB
}

node "Dispositivo do Usuário" <<device>> as client #EAF3FC {
  node "Navegador Web" <<executionEnvironment>> as browser #FFFFFF {
    artifact "Interface Web (SPA)\nindex.html · style.css · app.js\nimport-csv.js (leitura e validação CSV)" as ui #FEF9EB
    artifact "Sessão e Documentos\nCookie HttpOnly / SameSite=Strict\nConsulta a /guia e /diagrama (PDF)" as sess #FEF9EB
  }
}

node "Render - Serviço Web" <<cloud>> as render #EFEFFD {
  node "Proxy Reverso HTTPS / TLS\nTerminação TLS e encaminhamento HTTP interno" as proxy #EAF3FC
  node "Node.js 24 (instância única)" <<executionEnvironment>> as runtime #FFFFFF {
    artifact "Servidor de Aplicação NexoStock\nAPI JSON, autenticação scrypt e perfis\nValidação de SKU, código de barras e CSV\nInvariantes de saldo e sessões em memória" as app #FEF9EB
  }
}

node "Neon - Banco Gerenciado" <<cloud>> as neon #EBF5EE {
  database "PostgreSQL" <<database>> as pg #FFFFFF {
    artifact "Tabela nexostock_state\nEstado operacional em coluna JSONB\nCatálogo, saldos, pedidos, kardex e auditoria" as state #FEF9EB
    artifact "Integridade e Persistência\nBEGIN / COMMIT / ROLLBACK\nSELECT payload FOR UPDATE" as tx #FEF9EB
  }
}

github ..> render : implantação contínua (Git / HTTPS)
browser --> proxy : HTTPS / TLS\n(JSON / HTML / PDF)
proxy --> runtime : HTTP interno (PORT)
runtime --> pg : PostgreSQL / TLS\n(SQL + JSONB)

note bottom of render
  Canais de venda, etiquetas de envio e documentos fiscais operam em modo demonstrativo interno.
  Em desenvolvimento local sem DATABASE_URL, a persistência utiliza data/nexostock.json (FileStore).
end note
@enduml
